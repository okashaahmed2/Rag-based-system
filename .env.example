# Copy to .env (never commit .env) and adjust as needed.
# Every variable is optional; the values below are the defaults.
# Relative paths are resolved against the project root; absolute paths are used as given.

# Project root directory (default: derived from the package location; leave unset normally).
# RAG_PROJECT_ROOT=

# Folder watched for new PDFs waiting for ingestion.
RAG_INBOX_DIR=data/inbox

# Folder that receives successfully ingested PDFs.
RAG_PROCESSED_DIR=data/processed

# Folder that receives PDFs whose ingestion failed.
RAG_FAILED_DIR=data/failed

# Folder for the rotating application log (app.log).
RAG_LOG_DIR=logs

# Log level: DEBUG, INFO, WARNING, ERROR or CRITICAL (case-insensitive).
RAG_LOG_LEVEL=INFO

# Chunking. Both values are in CHARACTERS (not tokens), chosen to stay under
# the embedding model's token limit; they will be tuned in Phase 6.
# RAG_CHUNK_SIZE must be >= 100; 0 <= RAG_CHUNK_OVERLAP < RAG_CHUNK_SIZE.
RAG_CHUNK_SIZE=600
RAG_CHUNK_OVERLAP=120

# Embeddings. The same model is used for ingestion and query.
RAG_EMBEDDING_MODEL_NAME=sentence-transformers/all-MiniLM-L6-v2
# Chunks encoded per batch (must be >= 1).
RAG_EMBEDDING_BATCH_SIZE=32
# true = load the model from the local Hugging Face cache only, never contact the Hub
# (the model must already be downloaded).
RAG_EMBEDDING_LOCAL_FILES_ONLY=false

# Vector store (ChromaDB). Folder of the persistent store (git-ignored).
RAG_CHROMA_PATH=data/chroma
# Collection holding the document chunks (must not be empty; ChromaDB requires
# 3-512 characters from [a-zA-Z0-9._-], starting and ending with a letter or digit).
RAG_CHROMA_COLLECTION_NAME=chunks
