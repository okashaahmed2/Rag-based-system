# --- Python virtual environments ---
.venv/
venv/

# --- Python bytecode and test caches ---
__pycache__/
*.pyc
.pytest_cache/

# --- Packaging build metadata (created by `pip install -e .`) ---
*.egg-info/

# --- Secrets: real env file is never committed; the template is ---
.env
!.env.example

# --- Runtime document folders: ignore contents, keep the folders via .gitkeep ---
data/inbox/*
!data/inbox/.gitkeep
data/processed/*
!data/processed/.gitkeep
data/failed/*
!data/failed/.gitkeep
data/needs_ocr/*
!data/needs_ocr/.gitkeep

# --- Local storage: vector store and databases ---
data/chroma/
*.db
*.db-journal
*.db-wal
*.db-shm
*.sqlite
*.sqlite3

# --- Logs ---
logs/
*.log

# --- Editor and OS files (keep shared VS Code extension recommendations) ---
.vscode/*
!.vscode/extensions.json
Thumbs.db
desktop.ini
