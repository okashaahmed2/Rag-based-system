{
  "name": "RAG ingest (scheduled)",
  "nodes": [
    {
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "minutes",
              "minutesInterval": 5
            }
          ]
        }
      },
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.3,
      "position": [0, 0],
      "id": "23fbb567-a355-4897-a43f-2c6cb0ff3692",
      "name": "Schedule every 5 min"
    },
    {
      "parameters": {},
      "type": "n8n-nodes-base.manualTrigger",
      "typeVersion": 1,
      "position": [0, 200],
      "id": "c7554dc1-a658-4ae8-8342-63db7a996186",
      "name": "Manual run"
    },
    {
      "parameters": {
        "method": "POST",
        "url": "http://127.0.0.1:8000/ingest/scan",
        "options": {
          "response": {
            "response": {
              "responseFormat": "json"
            }
          },
          "timeout": 10000
        }
      },
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.4,
      "position": [240, 100],
      "id": "5cf3f4ef-f35e-475f-bf47-bf5026b24d79",
      "name": "Start scan",
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 5000
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict",
            "version": 3
          },
          "conditions": [
            {
              "id": "ff329b27-2e35-49a6-9953-c69c99b6d550",
              "leftValue": "={{ $json.already_running }}",
              "rightValue": "",
              "operator": {
                "type": "boolean",
                "operation": "true",
                "singleValue": true
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.3,
      "position": [460, 100],
      "id": "97dd398e-e95d-48eb-b485-7fe3e5b2640e",
      "name": "Already running?"
    },
    {
      "parameters": {},
      "type": "n8n-nodes-base.noOp",
      "typeVersion": 1,
      "position": [680, -60],
      "id": "6aab69ec-1fe5-48ef-9020-4913f7d71ad3",
      "name": "Skip: scan already running"
    },
    {
      "parameters": {
        "amount": 3,
        "unit": "seconds"
      },
      "type": "n8n-nodes-base.wait",
      "typeVersion": 1.1,
      "position": [680, 140],
      "id": "e53724e3-8c3d-4699-bdef-3a573ad043ac",
      "name": "Wait 3s",
      "webhookId": "2b39e1e3-f752-4ed4-8f82-a02f4b6a45fe"
    },
    {
      "parameters": {
        "url": "=http://127.0.0.1:8000/status/{{ $('Start scan').first().json.job_id }}",
        "options": {
          "response": {
            "response": {
              "responseFormat": "json"
            }
          },
          "timeout": 10000
        }
      },
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.4,
      "position": [900, 140],
      "id": "9101422b-1206-4cbe-b2d7-219b6ad750d8",
      "name": "Check status",
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 5000
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict",
            "version": 3
          },
          "conditions": [
            {
              "id": "50f667f3-da11-4c10-97e0-d165ab0cf3ce",
              "leftValue": "={{ ['queued','running'].includes($json.status) }}",
              "rightValue": "",
              "operator": {
                "type": "boolean",
                "operation": "true",
                "singleValue": true
              }
            },
            {
              "id": "2c6cd512-f90f-42be-882f-eecb1cb1bcd2",
              "leftValue": "={{ $runIndex }}",
              "rightValue": 40,
              "operator": {
                "type": "number",
                "operation": "lt"
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.3,
      "position": [1120, 140],
      "id": "db155919-04a0-4d0f-9888-2f32559eef3e",
      "name": "Still running?"
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict",
            "version": 3
          },
          "conditions": [
            {
              "id": "b70c17cb-bdc6-4e13-a5f2-ffdef4d2d1f9",
              "leftValue": "={{ $json.status }}",
              "rightValue": "succeeded",
              "operator": {
                "type": "string",
                "operation": "equals"
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.3,
      "position": [1340, 240],
      "id": "4fc55d65-dec3-4986-a92e-28979fadae67",
      "name": "Job succeeded?"
    },
    {
      "parameters": {},
      "type": "n8n-nodes-base.noOp",
      "typeVersion": 1,
      "position": [1560, 140],
      "id": "db363638-f59a-4414-82b5-82afb729a339",
      "name": "Done"
    },
    {
      "parameters": {
        "errorType": "errorMessage",
        "errorMessage": "=Scan job {{ $json.job_id }} ended with status '{{ $json.status }}'"
      },
      "type": "n8n-nodes-base.stopAndError",
      "typeVersion": 1,
      "position": [1560, 340],
      "id": "00920dbf-f739-447f-b67d-1c74d29bf732",
      "name": "Scan not succeeded"
    }
  ],
  "connections": {
    "Schedule every 5 min": {
      "main": [[{ "node": "Start scan", "type": "main", "index": 0 }]]
    },
    "Manual run": {
      "main": [[{ "node": "Start scan", "type": "main", "index": 0 }]]
    },
    "Start scan": {
      "main": [[{ "node": "Already running?", "type": "main", "index": 0 }]]
    },
    "Already running?": {
      "main": [
        [{ "node": "Skip: scan already running", "type": "main", "index": 0 }],
        [{ "node": "Wait 3s", "type": "main", "index": 0 }]
      ]
    },
    "Wait 3s": {
      "main": [[{ "node": "Check status", "type": "main", "index": 0 }]]
    },
    "Check status": {
      "main": [[{ "node": "Still running?", "type": "main", "index": 0 }]]
    },
    "Still running?": {
      "main": [
        [{ "node": "Wait 3s", "type": "main", "index": 0 }],
        [{ "node": "Job succeeded?", "type": "main", "index": 0 }]
      ]
    },
    "Job succeeded?": {
      "main": [
        [{ "node": "Done", "type": "main", "index": 0 }],
        [{ "node": "Scan not succeeded", "type": "main", "index": 0 }]
      ]
    }
  },
  "active": false,
  "settings": {
    "executionOrder": "v1",
    "timezone": "Asia/Karachi"
  },
  "tags": []
}
